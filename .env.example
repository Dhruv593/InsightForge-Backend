APP_NAME=Tatparya API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CONSOLE_LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARNING
# Local rotating files. Production also emits structured JSON to stdout for the host log viewer.
LOG_DIR=logs
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
SQL_ECHO=false

API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/insightforge

FRONTEND_URL=http://localhost:5173
# Production example: https://your-project.vercel.app (no trailing slash)
# Comma-separated owner accounts allowed to open the monitoring page.
ADMIN_EMAILS=owner@example.com

# Google OAuth Web application client ID (public ID, not a Gemini API key).
# Leave blank to disable. This GIS ID-token flow does not need a client secret.
# Add FRONTEND_URL as an Authorized JavaScript origin in Google Cloud Console.
# Use the same hostname for frontend/backend (localhost for both in development).
GOOGLE_CLIENT_ID=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional transactional email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Tatparya
SUPPORT_EMAIL=
SMTP_USE_TLS=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_SIZE_MB=25
MAX_PROFILE_ROWS=500000
# Reject decompression bombs and excessively wide tables during profiling.
MAX_EXPANDED_FILE_MB=100
MAX_DATASET_COLUMNS=200

GEMINI_API_KEY=
GEMINI_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

# Optional providers. They remain unavailable in the admin portal until both
# the API key and model name are configured.
OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=8192

# Razorpay Payment Gateway. Start with Test Mode keys, then replace them with
# Live Mode keys after completing Razorpay's go-live checklist.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Create a separate secret in Razorpay Dashboard > Webhooks.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_REQUEST_TIMEOUT_SECONDS=15

# Used until an admin saves a provider in Admin Dashboard > AI model.
DEFAULT_LLM_PROVIDER=gemini
LLM_REQUEST_TIMEOUT_SECONDS=60

# Optional metadata-only agent tracing. Get a key from smith.langchain.com.
# Leave disabled until ready to send execution metadata to LangSmith.
LANGSMITH_ENABLED=false
LANGSMITH_DETAIL_MODE=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insightforge
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional direct URL to the LangSmith project used by the owner monitoring page.
LANGSMITH_PROJECT_URL=
# Do NOT enable LANGSMITH_TRACING / LANGCHAIN_TRACING_V2 globally:
# automatic LangGraph tracing could capture raw business data.
